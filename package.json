{
  "name": "vfw-payload-cms",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "gen:im": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "gen:t": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "gen:dbs": "cross-env NODE_OPTIONS=--no-deprecation payload generate:db-schema",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "^3.40.0",
    "@payloadcms/db-postgres": "^3.40.0",
    "@payloadcms/live-preview-react": "^3.40.0",
    "@payloadcms/next": "^3.40.0",
    "@payloadcms/payload-cloud": "^3.40.0",
    "@payloadcms/plugin-form-builder": "^3.40.0",
    "@payloadcms/plugin-redirects": "^3.40.0",
    "@payloadcms/plugin-search": "^3.40.0",
    "@payloadcms/plugin-seo": "^3.40.0",
    "@payloadcms/richtext-lexical": "^3.40.0",
    "@payloadcms/ui": "^3.40.0",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "geist": "^1.4.2",
    "graphql": "^16.11.0",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "payload": "^3.40.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-social-media-embed": "^2.5.18",
    "sharp": "^0.32.6",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
